<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="Alert View Bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Test Buttons Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Cases:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security Review Alert"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestUnexpectedError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unexpected Error Alert"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Alert Model"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerHorizontal"
            android:layout_marginBottom="16dp" />

        <!-- Alert Component Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPAlertViewBottom Component:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.terminal3.gpcoreui.views.GPAlertViewBottom
                    android:id="@+id/alertViewBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>